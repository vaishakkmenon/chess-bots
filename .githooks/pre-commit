#!/bin/bash
# Pre-commit hook for chess-bots

set -e

echo "Running pre-commit checks..."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

RUST_DIR="rust-implementation/rust-engine"
RUST_CLI_DIR="rust-implementation/rust-cli"

# Check if any Rust files are staged
RUST_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

if [ -n "$RUST_STAGED" ]; then
    echo -e "${YELLOW}Checking Rust formatting...${NC}"

    if [ -d "$RUST_DIR" ]; then
        cd "$RUST_DIR"
        if ! cargo fmt -- --check 2>/dev/null; then
            echo -e "${RED}Rust formatting failed in rust-engine!${NC}"
            echo "Run 'cargo fmt' to fix."
            exit 1
        fi
        cd - > /dev/null
    fi

    if [ -d "$RUST_CLI_DIR" ]; then
        cd "$RUST_CLI_DIR"
        if ! cargo fmt -- --check 2>/dev/null; then
            echo -e "${RED}Rust formatting failed in rust-cli!${NC}"
            echo "Run 'cargo fmt' to fix."
            exit 1
        fi
        cd - > /dev/null
    fi

    echo -e "${GREEN}Rust formatting OK${NC}"
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
